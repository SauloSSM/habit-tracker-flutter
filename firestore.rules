rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(data) { return signedIn() && data.uid == request.auth.uid; }
    function unchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /usuarios/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'nome', 'telefone', 'email', 'createdAt', 'updatedAt'])
          && d.uid == uid && uid == request.auth.uid
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
          && d.telefone is string && d.telefone.size() <= 30
          && d.email == request.auth.token.email
          && d.updatedAt == request.time;
      }
      allow read: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn() && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validProfile() && unchanged();
      allow delete: if false;
    }
    match /habitos/{id} {
      function validCheckinChange() {
        let added = request.resource.data.checkins.removeAll(resource.data.checkins);
        let removed = resource.data.checkins.toSet().difference(request.resource.data.checkins.toSet());
        return added.size() <= 1 && removed.size() <= 1
          && (added.size() == 0 || (added[0] is string && added[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }
      function validHabit() {
        let d = request.resource.data;
        let r = getAfter(/databases/$(database)/documents/realizacoes/$(id)).data;
        return owner(d)
          && d.keys().hasOnly(['uid', 'title', 'description', 'weekdays', 'createdDay', 'createdAt', 'updatedAt', 'checkins'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.description is string && d.description.size() <= 300
          && d.weekdays is list && d.weekdays.size() > 0 && d.weekdays.size() <= 7
          && d.weekdays.toSet().size() == d.weekdays.size()
          && d.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
          && d.createdDay is string && d.createdDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.checkins is list && d.checkins.size() <= 10000
          && d.checkins.toSet().size() == d.checkins.size()
          && r.uid == d.uid && r.habitId == id && r.datas == d.checkins
          && r.createdDay == d.createdDay && d.updatedAt == request.time;
      }
      // Authenticated clients can test an unused ID in a creation transaction.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/habitos/$(id)) || owner(resource.data));
      allow list: if owner(resource.data);
      allow create: if validHabit() && request.resource.data.createdAt == request.time
        && request.resource.data.checkins.size() == 0;
      allow update: if owner(resource.data) && validHabit() && unchanged()
        && validCheckinChange()
        && request.resource.data.createdDay == resource.data.createdDay;
      allow delete: if owner(resource.data)
        && !existsAfter(/databases/$(database)/documents/realizacoes/$(id));
    }
    match /realizacoes/{id} {
      function validRealizations() {
        let d = request.resource.data;
        let h = getAfter(/databases/$(database)/documents/habitos/$(id)).data;
        return owner(d)
          && d.keys().hasOnly(['uid', 'habitId', 'datas', 'createdDay', 'createdAt', 'updatedAt'])
          && d.habitId == id && d.datas is list && d.datas.size() <= 10000
          && h.uid == d.uid && h.checkins == d.datas && h.createdDay == d.createdDay
          && d.updatedAt == request.time;
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/realizacoes/$(id)) || owner(resource.data));
      allow list: if owner(resource.data);
      allow create: if validRealizations() && request.resource.data.createdAt == request.time
        && request.resource.data.datas.size() == 0;
      allow update: if owner(resource.data) && validRealizations() && unchanged()
        && request.resource.data.habitId == resource.data.habitId
        && request.resource.data.createdDay == resource.data.createdDay;
      allow delete: if owner(resource.data)
        && !existsAfter(/databases/$(database)/documents/habitos/$(id));
    }
  }
}
